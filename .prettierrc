{
    "singleQuote": true,
    "printWidth": 120,
    "editor.formatOnSave": true,
    "proseWrap": "preserve",
    "tabWidth": 4,
    "requireConfig": true,
    "useTabs": false,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "jsxBracketSameLine": false,
    "quoteProps": "as-needed",
    "semi": false
}
