{
    "name": "core-server",
    "scripts": {
        "dev": "bun run --hot src/index.ts",
        "build": "bun build ./src/index.ts --target=bun --minify --sourcemap --outfile=build/server.js",
        "start": "bun run build/server.js",
        "db:generate": "bun drizzle-kit generate",
        "db:push": "bun drizzle-kit push",
        "db:migrate": "bun drizzle-kit migrate",
        "db:studio": "bun drizzle-kit studio --verbose"
    },
    "dependencies": {
        "@google-cloud/storage": "^7.12.1",
        "@hono/swagger-ui": "^0.4.0",
        "@hono/zod-openapi": "^0.15.2",
        "drizzle-kit": "^0.24.0",
        "drizzle-orm": "^0.33.0",
        "hono": "^4.5.4",
        "openai": "^4.55.7",
        "postgres": "^3.4.4",
        "ulidx": "^2.4.0"
    },
    "devDependencies": {
        "@types/bun": "latest"
    }
}
